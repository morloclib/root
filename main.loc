module root (*)

import internal

infixl 1 (|>)
infixr 6 (<>)
infixr 5 (++)
infixl 6 (+)
infixl 6 (-)
infixl 7 (*)
infixl 7 (/)
infixl 7 (//)
infixl 7 (%)
infixr 8 (**)

class Semigroup a where
  (<>) :: a -> a -> a

-- `mconcat xs` equals `fold (<>) mempty xs`; an instance whose `<>` copies its
-- operands implements it in one pass.
class Semigroup a => Monoid a where
  mempty :: a
  mconcat :: [a] -> a

-- Semigroup for Nat-parameterized containers
class SemigroupDim f where
  (++) :: f m a -> f n a -> f (m+n) a

-- Monoid for Nat-parameterized containers
class SemigroupDim f => MonoidDim f where
  empty0 :: f 0 a

class Integral a where
  zero :: a
  neg :: a -> a
  abs :: a -> a
  (+) :: a -> a -> a
  (-) :: a -> a -> a
  (*) :: a -> a -> a
  (//) :: a -> a -> a
  (%) :: a -> a -> a

  -- This is defined for integers ONLY when the power is positive
  (**) :: a -> a -> a

instance Integral Real
instance Integral Int
instance Integral I8
instance Integral I16
instance Integral I32
instance Integral I64
instance Integral U8
instance Integral U16
instance Integral U32
instance Integral U64
instance Integral F32
instance Integral F64
instance Numeric Real

instance Semigroup Str
instance Monoid Str

class Integral a => Numeric a where
  inv :: a -> a
  (/) :: a -> a -> a
  ln :: a -> a

--' Types with a least and a greatest value
class Bounded a where
  vmin :: a
  vmax :: a

instance Bounded Bool where
  vmin = False
  vmax = True

instance Bounded I8 where
  vmin = -0x80
  vmax = 0x7F

instance Bounded I16 where
  vmin = -0x8000
  vmax = 0x7FFF

instance Bounded I32 where
  vmin = -0x80000000
  vmax = 0x7FFFFFFF

instance Bounded I64 where
  vmin = -0x8000000000000000
  vmax = 0x7FFFFFFFFFFFFFFF

instance Bounded U8 where
  vmin = 0
  vmax = 0xFF

instance Bounded U16 where
  vmin = 0
  vmax = 0xFFFF

instance Bounded U32 where
  vmin = 0
  vmax = 0xFFFFFFFF

instance Bounded U64 where
  vmin = 0
  vmax = 0xFFFFFFFFFFFFFFFF

class Foldable f where
  fold :: (b -> a -> b) -> b -> f a -> b
  fold1 :: (b -> a -> b) -> f a -> b
  safeFold1 :: (b -> a -> b) -> f a -> ?b
  length :: f a -> Int

class Functor f where
  map :: (a -> b) -> f a -> f b

class Readable a where
  -- Parsing touches nothing, so with failure carried in the result this is
  -- pure and composes in `map`.
  read :: Str -> Try Str a

instance Sizeable Str

---- Sequence definitions -------------------------------------------

class Stack f where
  cons :: a -> f a -> f a
  uncons :: f a -> (a, f a)

class Queue f where
  snoc :: f a -> a -> f a
  unsnoc :: f a -> (f a, a)

instance Semigroup (List a)
instance Monoid (List a)
instance Functor List
instance Foldable List
instance Sizeable (List a)
instance Indexable List
instance Sliceable List
instance Stack List
instance Queue List

--' A list with O(n) random access and O(1) start/end access
--' @metavar LIST
newtype Deque a = List a
instance Semigroup (Deque a)
instance Monoid (Deque a)
instance Functor Deque
instance Foldable Deque
instance Stack Deque
instance Queue Deque

-- this instance is needed for building Deque types from list literals
-- it also provides pack/unpack functions for Deque/List explicit conversions
instance Packable (List a) (Deque a)

-- numerics
--             F32 -----> F64
--            /          /
--       U8 --> U16 --> U32 --> U64
--      /      \          \         \
--  Bool        \          \    Int  \
--      \        \          \  /      \
--       I8 -->  I16 -----> I32 ----> I64
--                   \        \
--                    F32 --> F64
--                       \
--                        Real
class TotalInto a b where
  into :: a -> b

class PartialInto a b where
  -- Every instance is a sourced conversion that raises when the value does
  -- not fit, so the failure is a native throw rather than data. Wrap the
  -- call in `@try` to get it as a `Try`.
  tryInto :: a -> b

-- lossy conversions to real
class RealLike a where
  toReal :: a -> Real

instance TotalInto a a where
  into x = x

---------------------------------------------------------------------


-- Combinators
--------------

id :: a -> a
id x = x

-- Apply a function to a value, written left to right. Binds looser than
-- everything else, so a chain reads as a pipeline:
--
--   asCol "team" names
--     |> addCol "played" plays
--     |> addCol "won" wins
--     |> sortRows [("won", False)]
--
-- The alternative is nesting, which reads inside out and puts the first
-- step last. Where a type carries an order -- a table's columns -- the
-- pipeline also makes the source order and the schema order agree.
(|>) :: a -> (a -> b) -> b
(|>) x f = f x

seq :: a -> b -> b
seq x y = y

const :: a -> b -> a
const x y = x

flip :: (a -> b -> c) -> b -> a -> c
flip f x y = f y x

-- From the "To Mock a Mockingbird" aviary
starling :: (b -> c -> d) -> (a -> b) -> (a -> c) -> a -> d
starling bcd ab ac a = bcd (ab a) (ac a)

on :: (b -> b -> c) -> (a -> b) -> a -> a -> c
on f g x y = f (g x) (g y)

-- Logicals
--------------

not :: Bool -> Bool

--' Optionals
--------------

--' The value inside an optional
--'
--' The optional must not be Null; test it with `isNull` first.
require :: ?a -> a

--' Whether an optional is Null
isNull :: ?a -> Bool

xor :: Bool -> Bool -> Bool
xor x y = (nand x y) && (nand (not x) (not y))

nand :: Bool -> Bool -> Bool
nand x y = not (x && y)

-- Tuples
--------------

curry :: ((a, b) -> c) -> a -> b -> c
curry f x y = f (x, y)

curry3 :: ((a, b, c) -> d) -> a -> b -> c -> d
curry3 f x y z = f (x, y, z)

uncurry :: (a -> b -> c) -> (a, b) -> c
uncurry f xy = f (.0 xy) (.1 xy)

uncurry3 :: (a -> b -> c -> d) -> (a, b, c) -> d
uncurry3 f xyz = f (.0 xyz) (.1 xyz) (.2 xyz)

toSnd :: (a -> b) -> a -> (a, b)
toSnd f x = (x, f x)

toFst :: (a -> b) -> a -> (b, a)
toFst f x = (f x, x)

-- Ord
--------------

min :: Ord a => a -> a -> a
min x y ? x < y = x
        : y

max :: Ord a => a -> a -> a
max x y ? x < y = y
        : x

-- Saturating arithmetic
--------------------------

--' Sum, held at the type's bounds instead of overflowing
addSat :: (Bounded a, Integral a, Ord a) => a -> a -> a
addSat a b
  ? b > zero && a > vmax - b = vmax
  ? b < zero && a < vmin - b = vmin
  : a + b

--' Difference, held at the type's bounds instead of overflowing
subSat :: (Bounded a, Integral a, Ord a) => a -> a -> a
subSat a b
  ? b < zero && a > vmax + b = vmax
  ? b > zero && a < vmin + b = vmin
  : a - b

--' Product, held at the type's bounds instead of overflowing
mulSat :: (Bounded a, Integral a, Ord a) => a -> a -> a
mulSat a b
  ? a > zero && b > zero && a > vmax // b = vmax
  ? a < zero && b < zero && a < vmax // b = vmax
  ? a > zero && b < zero && b < vmin // a = vmin
  ? a < zero && b > zero && a < vmin // b = vmin
  : a * b

--' Negation, held at the type's bounds instead of overflowing
--'
--' The negation of the least signed value is the greatest; that of an
--' unsigned value other than 0 is 0.
negSat :: (Bounded a, Integral a, Ord a) => a -> a
negSat a = subSat zero a

-- Foldable-derived operations
-------------------------------

any :: Foldable f => (a -> Bool) -> f a -> Bool
any f = fold (\b a -> b || f a) False

all :: Foldable f => (a -> Bool) -> f a -> Bool
all f = fold (\b a -> b && f a) True

elem :: (Foldable f, Eq a) => a -> f a -> Bool
elem x = any ((==) x)

--' Combine a list of values, such as lists or strings, in order
concat :: Monoid a => [a] -> a
concat = mconcat

--' Map each element to a value and combine the results in order
concatMap :: Monoid b => (a -> b) -> [a] -> b
concatMap f xs = mconcat (map f xs)

sum :: (Foldable f, Integral a) => f a -> a
sum = fold (+) zero

-- Sequence primitives (need language implementations)

sort :: Ord a => [a] -> [a]
groupSort :: Ord a => [(a, b)] -> [(a, [b])]

sortBy :: (a -> a -> Bool) -> [a] -> [a]
filter :: (a -> Bool) -> [a] -> [a]
takeWhile :: (a -> Bool) -> [a] -> [a]
dropWhile :: (a -> Bool) -> [a] -> [a]
scanl :: (b -> a -> b) -> b -> [a] -> [b]
intersperse :: a -> [a] -> [a]
replicate :: Int -> a -> [a]
iterate :: Int -> (a -> a) -> a -> [a]
groupBy :: (a -> a -> Bool) -> [a] -> [[a]]
enumerate :: [a] -> [(Int, a)]
find :: (a -> Bool) -> [a] -> ?a

-- Sequence-derived operations

partition :: (a -> Bool) -> [a] -> ([a], [a])
partition p xs = (filter p xs, filter (not . p) xs)

unique :: Eq a => [a] -> [a]

--' Join values with a separator between each pair
intercalate :: Monoid a => a -> [a] -> a
intercalate sep xss = mconcat (intersperse sep xss)

-- List-specific operations
-----------------------------

zipWith :: (a -> b -> c) -> [a] -> [b] -> [c]

zip :: [a] -> [b] -> [(a, b)]
zip = zipWith (\a b -> (a, b))

unzip :: [(a, b)] -> ([a], [b])

-- Integers in the half-open interval [a, b), matching Python's range and
-- root's slice:
--   range 0 5 == [0,1,2,3,4]
--   range 3 3 == []
--   range 5 1 == []
range :: Int -> Int -> [Int]

-- Integers from a, stepping by step, while strictly less than b:
--   rangeStep 0 10 2 == [0,2,4,6,8]
--   rangeStep 0 6 3  == [0,3]
rangeStep :: Int -> Int -> Int -> [Int]

-------------------------------------------------------------------------------
-- Comparison of compound values, through the instances of their parts

--' -1, 0 or 1 as the first value is below, equal to or above the second
compare :: Ord a => a -> a -> Int
compare x y
  ? x < y = 0 - 1
  : ? y < x = 1
  : 0

--' The first comparison unless it is equal, then the second
thenCompare :: Int -> Int -> Int
thenCompare c d
  ? c == 0 = d
  : c

--' Compare two lists element by element, then by length
compareList :: Ord a => [a] -> [a] -> Int
compareList xs ys =
  thenCompare
    (fold (\c p -> thenCompare c (compare (.0 p) (.1 p))) 0 (zip xs ys))
    (compare (length xs) (length ys))

--' Whether two lists hold equal elements in the same order
equalList :: Eq a => [a] -> [a] -> Bool
equalList xs ys = length xs == length ys && all (\p -> .0 p == .1 p) (zip xs ys)

instance Eq a => Eq (List a) where
  (==) xs ys = equalList xs ys
  (!=) xs ys = not (equalList xs ys)

instance Ord a => Ord (List a) where
  (<) xs ys = compareList xs ys < 0
  (<=) xs ys = compareList xs ys <= 0
  (>) xs ys = compareList xs ys > 0
  (>=) xs ys = compareList xs ys >= 0

--' The elements of a deque, first to last
dequeList :: Deque a -> [a]
dequeList x = unpack x

instance Eq a => Eq (Deque a) where
  (==) x y = equalList (dequeList x) (dequeList y)
  (!=) x y = not (equalList (dequeList x) (dequeList y))

instance Ord a => Ord (Deque a) where
  (<) x y = compareList (dequeList x) (dequeList y) < 0
  (<=) x y = compareList (dequeList x) (dequeList y) <= 0
  (>) x y = compareList (dequeList x) (dequeList y) > 0
  (>=) x y = compareList (dequeList x) (dequeList y) >= 0

--' Whether two optionals are both Null or hold equal values
equalOptional :: Eq a => ?a -> ?a -> Bool
equalOptional x y
  ? isNull x = isNull y
  : ? isNull y = False
  : require x == require y

--' Compare two optionals, Null first
compareOptional :: Ord a => ?a -> ?a -> Int
compareOptional x y
  ? isNull x && isNull y = 0
  : ? isNull x = 0 - 1
  : ? isNull y = 1
  : compare (require x) (require y)

instance Eq a => Eq ?a where
  (==) x y = equalOptional x y
  (!=) x y = not (equalOptional x y)

instance Ord a => Ord ?a where
  (<) x y = compareOptional x y < 0
  (<=) x y = compareOptional x y <= 0
  (>) x y = compareOptional x y > 0
  (>=) x y = compareOptional x y >= 0

instance Eq Unit where
  (==) x y = True
  (!=) x y = False

instance Ord Unit where
  (<) x y = False
  (<=) x y = True
  (>) x y = False
  (>=) x y = True

--' Compare two 2-tuples field by field
compareTuple2 :: (Ord a, Ord b) => (a, b) -> (a, b) -> Int
compareTuple2 x y = thenCompare (compare (.0 x) (.0 y)) (compare (.1 x) (.1 y))

instance (Eq a, Eq b) => Eq (a, b) where
  (==) x y = .0 x == .0 y && .1 x == .1 y
  (!=) x y = not (.0 x == .0 y && .1 x == .1 y)

instance (Ord a, Ord b) => Ord (a, b) where
  (<) x y = compareTuple2 x y < 0
  (<=) x y = compareTuple2 x y <= 0
  (>) x y = compareTuple2 x y > 0
  (>=) x y = compareTuple2 x y >= 0

--' Compare two 3-tuples field by field
compareTuple3 :: (Ord a, Ord b, Ord c) => (a, b, c) -> (a, b, c) -> Int
compareTuple3 x y = thenCompare (compare (.0 x) (.0 y)) (thenCompare (compare (.1 x) (.1 y)) (compare (.2 x) (.2 y)))

instance (Eq a, Eq b, Eq c) => Eq (a, b, c) where
  (==) x y = .0 x == .0 y && .1 x == .1 y && .2 x == .2 y
  (!=) x y = not (.0 x == .0 y && .1 x == .1 y && .2 x == .2 y)

instance (Ord a, Ord b, Ord c) => Ord (a, b, c) where
  (<) x y = compareTuple3 x y < 0
  (<=) x y = compareTuple3 x y <= 0
  (>) x y = compareTuple3 x y > 0
  (>=) x y = compareTuple3 x y >= 0

--' Compare two 4-tuples field by field
compareTuple4 :: (Ord a, Ord b, Ord c, Ord d) => (a, b, c, d) -> (a, b, c, d) -> Int
compareTuple4 x y = thenCompare (compare (.0 x) (.0 y)) (thenCompare (compare (.1 x) (.1 y)) (thenCompare (compare (.2 x) (.2 y)) (compare (.3 x) (.3 y))))

instance (Eq a, Eq b, Eq c, Eq d) => Eq (a, b, c, d) where
  (==) x y = .0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y
  (!=) x y = not (.0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y)

instance (Ord a, Ord b, Ord c, Ord d) => Ord (a, b, c, d) where
  (<) x y = compareTuple4 x y < 0
  (<=) x y = compareTuple4 x y <= 0
  (>) x y = compareTuple4 x y > 0
  (>=) x y = compareTuple4 x y >= 0

--' Compare two 5-tuples field by field
compareTuple5 :: (Ord a, Ord b, Ord c, Ord d, Ord e) => (a, b, c, d, e) -> (a, b, c, d, e) -> Int
compareTuple5 x y = thenCompare (compare (.0 x) (.0 y)) (thenCompare (compare (.1 x) (.1 y)) (thenCompare (compare (.2 x) (.2 y)) (thenCompare (compare (.3 x) (.3 y)) (compare (.4 x) (.4 y)))))

instance (Eq a, Eq b, Eq c, Eq d, Eq e) => Eq (a, b, c, d, e) where
  (==) x y = .0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y
  (!=) x y = not (.0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y)

instance (Ord a, Ord b, Ord c, Ord d, Ord e) => Ord (a, b, c, d, e) where
  (<) x y = compareTuple5 x y < 0
  (<=) x y = compareTuple5 x y <= 0
  (>) x y = compareTuple5 x y > 0
  (>=) x y = compareTuple5 x y >= 0

--' Compare two 6-tuples field by field
compareTuple6 :: (Ord a, Ord b, Ord c, Ord d, Ord e, Ord f) => (a, b, c, d, e, f) -> (a, b, c, d, e, f) -> Int
compareTuple6 x y = thenCompare (compare (.0 x) (.0 y)) (thenCompare (compare (.1 x) (.1 y)) (thenCompare (compare (.2 x) (.2 y)) (thenCompare (compare (.3 x) (.3 y)) (thenCompare (compare (.4 x) (.4 y)) (compare (.5 x) (.5 y))))))

instance (Eq a, Eq b, Eq c, Eq d, Eq e, Eq f) => Eq (a, b, c, d, e, f) where
  (==) x y = .0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y && .5 x == .5 y
  (!=) x y = not (.0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y && .5 x == .5 y)

instance (Ord a, Ord b, Ord c, Ord d, Ord e, Ord f) => Ord (a, b, c, d, e, f) where
  (<) x y = compareTuple6 x y < 0
  (<=) x y = compareTuple6 x y <= 0
  (>) x y = compareTuple6 x y > 0
  (>=) x y = compareTuple6 x y >= 0

--' Compare two 7-tuples field by field
compareTuple7 :: (Ord a, Ord b, Ord c, Ord d, Ord e, Ord f, Ord g) => (a, b, c, d, e, f, g) -> (a, b, c, d, e, f, g) -> Int
compareTuple7 x y = thenCompare (compare (.0 x) (.0 y)) (thenCompare (compare (.1 x) (.1 y)) (thenCompare (compare (.2 x) (.2 y)) (thenCompare (compare (.3 x) (.3 y)) (thenCompare (compare (.4 x) (.4 y)) (thenCompare (compare (.5 x) (.5 y)) (compare (.6 x) (.6 y)))))))

instance (Eq a, Eq b, Eq c, Eq d, Eq e, Eq f, Eq g) => Eq (a, b, c, d, e, f, g) where
  (==) x y = .0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y && .5 x == .5 y && .6 x == .6 y
  (!=) x y = not (.0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y && .5 x == .5 y && .6 x == .6 y)

instance (Ord a, Ord b, Ord c, Ord d, Ord e, Ord f, Ord g) => Ord (a, b, c, d, e, f, g) where
  (<) x y = compareTuple7 x y < 0
  (<=) x y = compareTuple7 x y <= 0
  (>) x y = compareTuple7 x y > 0
  (>=) x y = compareTuple7 x y >= 0

--' Compare two 8-tuples field by field
compareTuple8 :: (Ord a, Ord b, Ord c, Ord d, Ord e, Ord f, Ord g, Ord h) => (a, b, c, d, e, f, g, h) -> (a, b, c, d, e, f, g, h) -> Int
compareTuple8 x y = thenCompare (compare (.0 x) (.0 y)) (thenCompare (compare (.1 x) (.1 y)) (thenCompare (compare (.2 x) (.2 y)) (thenCompare (compare (.3 x) (.3 y)) (thenCompare (compare (.4 x) (.4 y)) (thenCompare (compare (.5 x) (.5 y)) (thenCompare (compare (.6 x) (.6 y)) (compare (.7 x) (.7 y))))))))

instance (Eq a, Eq b, Eq c, Eq d, Eq e, Eq f, Eq g, Eq h) => Eq (a, b, c, d, e, f, g, h) where
  (==) x y = .0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y && .5 x == .5 y && .6 x == .6 y && .7 x == .7 y
  (!=) x y = not (.0 x == .0 y && .1 x == .1 y && .2 x == .2 y && .3 x == .3 y && .4 x == .4 y && .5 x == .5 y && .6 x == .6 y && .7 x == .7 y)

instance (Ord a, Ord b, Ord c, Ord d, Ord e, Ord f, Ord g, Ord h) => Ord (a, b, c, d, e, f, g, h) where
  (<) x y = compareTuple8 x y < 0
  (<=) x y = compareTuple8 x y <= 0
  (>) x y = compareTuple8 x y > 0
  (>=) x y = compareTuple8 x y >= 0
